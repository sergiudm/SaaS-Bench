# LLM provider (OpenAI-compatible chat-completions endpoint).
#
# SaaS-Bench's reference agent uses browser-use, which talks to any
# OpenAI-compatible API.
# (https://developer.qiniu.com/aitokenapi/13379/real-time-ai-interface-api).
# You can point these at any OpenAI-compatible provider.
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=base-url
LLM_MODEL=your-model-name

# Optional for Gemini runs: provide multiple keys to rotate across when one
# returns quota/rate-limit/provider errors. GEMINI_API_KEYS takes precedence
# for Gemini models and may be written as a list.
# GEMINI_API_KEYS=[
#   "sk-gemini-key-1",
#   "sk-gemini-key-2",
# ]
# LLM_API_KEYS=["sk-key-1", "sk-key-2", "sk-key-3"]

# Optional: abort a task after this many consecutive LLM provider/API failures.
# Defaults to max(3, number of Gemini keys) for Gemini, or 3 otherwise.
# LLM_API_ABORT_RETRIES=3

# Optional cost accounting overrides, in USD per 1M tokens. If unset,
# SaaS-Bench uses built-in estimates for a small set of common model names and
# reports null spending for unknown models.
# LLM_INPUT_PRICE_PER_1M_TOKENS=0.50
# LLM_OUTPUT_PRICE_PER_1M_TOKENS=3.00
# LLM_CACHED_INPUT_PRICE_PER_1M_TOKENS=0.05
# LLM_CACHE_CREATION_INPUT_PRICE_PER_1M_TOKENS=0.50

# Optional: where per-task transient files live (chrome user-data dirs and
# agent file-system workdirs). Defaults to $TMPDIR/saas_bench. Override if
# /tmp is small or on a slow filesystem.
# SAAS_BENCH_TMP=/tmp/saas_bench
